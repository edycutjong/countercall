{
  "name": "countercall",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Phones an Indonesian government service counter and returns a validated checklist of what to bring.",
  "license": "MIT",
  "scripts": {
    "verify": "node scripts/verify_calle.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.mjs",
    "audit": "npm audit --audit-level=high",
    "bench": "node scripts/bench.mjs",
    "check:counts": "node scripts/check_counts.mjs",
    "check:web": "node scripts/check_web.mjs",
    "check:nodial": "node scripts/check_no_dial.mjs",
    "ci": "npm run lint && npm run test && npm run check:counts && npm run check:web && npm run check:nodial && npm run audit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@call-e/calle": "^0.7.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
