# ── CALL-E ───────────────────────────────────────────────────
# The Developer API key for the account that published the Goal.
# Get from: https://heycall-e.com → account settings → Developer API
# The key is owner-scoped: it only sees Goals published by this same account.
CALLE_API_KEY=your-calle-api-key-here

# The Goal this skill runs. Goals are authored and published in CALL-E Chat —
# publishing is deliberately NOT a Developer API operation, so this cannot be
# created from code. Publish the Goal, then paste its id here.
# Read the pinned contract it must match: skills/countercall/scripts/contract.mjs
COUNTERCALL_GOAL_ID=goal_your_goal_id_here

# ── Notes ────────────────────────────────────────────────────
# Neither variable is needed to run the test suite, the linter, or any dry run.
#   npm test                      # 210 tests, no credentials
#   npm run bench -- --plan       # prints the call plan, dials nothing
#
# CALLE_API_KEY alone unlocks the live read tests (goals.list / goals.get). Those
# place no phone call and consume no call credit.
#
# Both together are required before anything can actually dial, and even then
# scripts/call.mjs needs an explicit --live flag.
#
# Never commit a real key. Credentials belong in ~/.config, not in this tree.
